{
  "PolicyDocument": {
    "Statement": [
      {
        "Action": [
          "dynamodb:GetItem",
          "dynamodb:Query",
          "dynamodb:Scan",
          "dynamodb:PutItem",
          "dynamodb:UpdateItem"
        ],
        "Effect": "Allow",
        "Resource": [
          "arn:aws:dynamodb:ap-southeast-1:600929977538:table/kcmps",
          "arn:aws:dynamodb:ap-southeast-1:600929977538:table/kcmps/index/*"
        ],
        "Sid": "TableReadWrite"
      },
      {
        "Action": "dynamodb:TransactWriteItems",
        "Effect": "Allow",
        "Resource": "arn:aws:dynamodb:ap-southeast-1:600929977538:table/kcmps",
        "Sid": "TableTransact"
      },
      {
        "Action": [
          "logs:CreateLogGroup",
          "logs:CreateLogStream",
          "logs:PutLogEvents"
        ],
        "Effect": "Allow",
        "Resource": "arn:aws:logs:ap-southeast-1:600929977538:*",
        "Sid": "Logs"
      },
      {
        "Action": "cognito-idp:ListUsersInGroup",
        "Effect": "Allow",
        "Resource": "arn:aws:cognito-idp:ap-southeast-1:600929977538:userpool/ap-southeast-1_LHJsFdCgo",
        "Sid": "ListAdminGroupForApprovals"
      }
    ],
    "Version": "2012-10-17"
  },
  "PolicyName": "design-library-inline",
  "RoleName": "kcmps-design-library-lambda-role"
}
