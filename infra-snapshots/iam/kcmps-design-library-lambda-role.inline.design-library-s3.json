{
  "PolicyDocument": {
    "Statement": [
      {
        "Action": [
          "s3:PutObject",
          "s3:GetObject",
          "s3:GetObjectTagging",
          "s3:PutObjectTagging"
        ],
        "Effect": "Allow",
        "Resource": "arn:aws:s3:::kcmps-design-originals-est-2026/designs/*",
        "Sid": "DesignOriginalsReadWrite"
      },
      {
        "Action": [
          "s3:PutObject",
          "s3:PutObjectTagging"
        ],
        "Effect": "Allow",
        "Resource": "arn:aws:s3:::kcmps-online-bucket-est-2026/assets/designs/*",
        "Sid": "PublishWebReadyImageAndManifest"
      },
      {
        "Action": [
          "s3:DeleteObject"
        ],
        "Effect": "Allow",
        "Resource": "arn:aws:s3:::kcmps-online-bucket-est-2026/assets/designs/*",
        "Sid": "DeletePublishedImageOnPurge"
      }
    ],
    "Version": "2012-10-17"
  },
  "PolicyName": "design-library-s3",
  "RoleName": "kcmps-design-library-lambda-role"
}
