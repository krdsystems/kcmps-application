        "Effect": "Allow",
        "Resource": [
          "arn:aws:cognito-idp:ap-southeast-1:600929977538:userpool/ap-southeast-1_iDvAEumNp",
          "arn:aws:cognito-idp:ap-southeast-1:600929977538:userpool/ap-southeast-1_LHJsFdCgo"
        ]
      },
      {
        "Action": [
          "logs:CreateLogGroup",
