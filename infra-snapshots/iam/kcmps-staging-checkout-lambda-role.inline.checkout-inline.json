{
  "PolicyDocument": {
    "Statement": [
      {
        "Action": [
          "dynamodb:GetItem",
          "dynamodb:Query",
          "dynamodb:PutItem",
          "dynamodb:UpdateItem",
          "dynamodb:TransactWriteItems"
        ],
        "Effect": "Allow",
        "Resource": [
          "arn:aws:dynamodb:ap-southeast-1:600929977538:table/kcmps-staging",
          "arn:aws:dynamodb:ap-southeast-1:600929977538:table/kcmps-staging/index/*"
        ],
        "Sid": "TableAccess"
      },
      {
        "Action": "s3:PutObject",
        "Effect": "Allow",
        "Resource": "arn:aws:s3:::kcmps-payment-uploads-staging/payments/*",
        "Sid": "PaymentScreenshotUpload"
      },
      {
        "Action": "s3:PutObject",
        "Effect": "Allow",
        "Resource": "arn:aws:s3:::kcmps-payment-uploads-staging/design-uploads/*",
        "Sid": "DesignFileUpload"
      },
      {
        "Action": "ses:SendEmail",
        "Effect": "Allow",
        "Resource": "arn:aws:ses:ap-southeast-1:600929977538:identity/kcmps.com",
        "Sid": "SendCheckoutEmail"
      },
      {
        "Action": [
          "logs:CreateLogGroup",
          "logs:CreateLogStream",
          "logs:PutLogEvents"
        ],
        "Effect": "Allow",
        "Resource": "arn:aws:logs:ap-southeast-1:600929977538:*",
        "Sid": "Logs"
      }
    ],
    "Version": "2012-10-17"
  },
  "PolicyName": "checkout-inline",
  "RoleName": "kcmps-staging-checkout-lambda-role"
}
