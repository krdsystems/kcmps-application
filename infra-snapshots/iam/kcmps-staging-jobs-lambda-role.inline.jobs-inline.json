{
  "PolicyDocument": {
    "Statement": [
      {
        "Action": [
          "dynamodb:GetItem",
          "dynamodb:Query",
          "dynamodb:Scan",
          "dynamodb:PutItem",
          "dynamodb:UpdateItem",
          "dynamodb:DeleteItem"
        ],
        "Effect": "Allow",
        "Resource": [
          "arn:aws:dynamodb:ap-southeast-1:600929977538:table/kcmps-staging",
          "arn:aws:dynamodb:ap-southeast-1:600929977538:table/kcmps-staging/index/*"
        ],
        "Sid": "TableReadWrite"
      },
      {
        "Action": "dynamodb:TransactWriteItems",
        "Effect": "Allow",
        "Resource": "arn:aws:dynamodb:ap-southeast-1:600929977538:table/kcmps-staging",
        "Sid": "TableTransact"
      },
      {
        "Action": [
          "dynamodb:DescribeStream",
          "dynamodb:GetRecords",
          "dynamodb:GetShardIterator",
          "dynamodb:ListStreams"
        ],
        "Effect": "Allow",
        "Resource": "arn:aws:dynamodb:ap-southeast-1:600929977538:table/kcmps-staging/stream/*",
        "Sid": "StreamsRead"
      },
      {
        "Action": [
          "ses:SendEmail",
          "ses:SendRawEmail"
        ],
        "Effect": "Allow",
        "Resource": "arn:aws:ses:ap-southeast-1:600929977538:identity/kcmps.com",
        "Sid": "SesSend"
      },
      {
        "Action": [
          "logs:CreateLogGroup",
          "logs:CreateLogStream",
          "logs:PutLogEvents"
        ],
        "Effect": "Allow",
        "Resource": "arn:aws:logs:ap-southeast-1:600929977538:*",
        "Sid": "Logs"
      }
    ],
    "Version": "2012-10-17"
  },
  "PolicyName": "jobs-inline",
  "RoleName": "kcmps-staging-jobs-lambda-role"
}
